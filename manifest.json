{
  "name": "Humble New Tab Page: Modern",
  "short_name": "HNTP Modern",
  "version": "2.0.1",
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "humble-new-tab-modern@janlosk",
      "strict_min_version": "134.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "description": "A modern, firefox.com-inspired redesign of the classic Humble New Tab Page: bookmarks, most visited and recently closed on a dark purple new tab with vector icons and English/Russian UI.",
  "homepage_url": "https://github.com/JanLosk/HumbleNewTabPageModern",
  "icons": {
    "128": "icons/icon_128.png",
    "48": "icons/icon_48.png",
    "16": "icons/icon_16.png"
  },
  "permissions": [
    "bookmarks",
    "topSites",
    "tabs",
    "sessions"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "chrome_settings_overrides": {
    "homepage": "newtab.html"
  },
  "options_ui": {
    "page": "newtab.html?options",
    "open_in_tab": true
  }
}